rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (HIPAA & CMIA Compliance)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. USERS COLLECTION (Identity & Credentials)
    // ==========================================
    match /users/{userId} {
      // DATA MINIMIZATION & RBAC: 
      // Anyone can view a profile ONLY IF it is set to 'public' (for QR scanning).
      // Otherwise, only the authenticated owner can access their data.
      allow read: if isOwner(userId) || resource.data.visibility == 'public';
      
      // Only the authenticated owner can modify their own identity data.
      allow create, update: if isOwner(userId);
      
      // VETOED: No deleting users from the client side. Deletion must go through 
      // an authenticated Cloud Function to ensure audit trails and HIPAA compliance.
      allow delete: if false;

      // Subcollection for legacy credentials (if any)
      match /credentials/{credentialId} {
        allow read: if isOwner(userId) || get(/databases/$(database)/documents/users/$(userId)).data.visibility == 'public';
        allow write: if isOwner(userId);
      }
    }

    // ==========================================
    // 2. REVIEWS COLLECTION (Immutable Audit Logs)
    // ==========================================
    match /reviews/{reviewId} {
      // CMIA STRICTNESS: Reviews can be submitted by patients or peers, but they 
      // MUST remain immutable. They cannot be altered or deleted from the client UI.
      allow create: if true; 
      allow update, delete: if false; 
      
      // Providers can read their own reviews. Public reviews can be read by anyone 
      // ONLY IF the associated provider's profile is set to public.
      allow read: if resource.data.providerId == request.auth.uid || 
                  get(/databases/$(database)/documents/users/$(resource.data.providerId)).data.visibility == 'public';
    }
    
    // ==========================================
    // 3. DEFAULT ZERO-TRUST RULE
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
